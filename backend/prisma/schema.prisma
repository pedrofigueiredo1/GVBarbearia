// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Entidade referente à User Story "Cadastro de Profissional" (item 2.13 da documentação).
// Campos obrigatórios definidos nos Critérios da US: nome, especialidade e descrição.
model Profissional {
  id            Int           @id @default(autoincrement())
  nome          String
  especialidade String
  descricao     String
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt
  agendamentos  Agendamento[]

  @@map("profissionais")
}

// Entidade referente à User Story "Cadastro de Serviço" (item 2.9 da documentação).
// Campos obrigatórios definidos nos Critérios da US: nome, descrição, valor e duração.
model Servico {
  id             Int           @id @default(autoincrement())
  nome           String
  descricao      String
  valor          Decimal       @db.Decimal(10, 2)
  duracaoMinutos Int
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
  agendamentos   Agendamento[]

  @@map("servicos")
}

// Entidade referente à User Story "Cadastro de Produto" (item 2.17 da documentação).
// Campos obrigatórios definidos nos Critérios da US: nome, descrição e preço.
model Produto {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String
  preco        Decimal  @db.Decimal(10, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("produtos")
}

// Entidade referente às User Stories "Consulta/Edição de Informações da
// Barbearia" (itens 2.7 e 2.8). Diferente das demais entidades, não existe
// US de "Cadastro" — é um registro único com os dados institucionais do
// estabelecimento, sempre acessado/atualizado através do id fixo 1.
model Barbearia {
  id                   Int      @id @default(autoincrement())
  nome                 String
  endereco             String
  telefone             String
  horarioFuncionamento String
  atualizadoEm         DateTime @updatedAt

  @@map("barbearia")
}

// Entidade referente às User Stories "Cadastro/Consulta/Edição/Exclusão de
// Administrador" (itens 2.3 a 2.6). O campo `login` é o e-mail do
// administrador — usado tanto para autenticação quanto para a futura
// recuperação de senha (ainda não implementada, depende do envio de e-mail).
model Administrador {
  id           Int      @id @default(autoincrement())
  nome         String
  login        String   @unique
  senha        String // hash bcrypt, nunca texto puro
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("administradores")
}

// Entidade referente às User Stories "Consulta/Edição/Exclusão de Cliente"
// (itens 2.21 a 2.23) e também ao Cadastro de Cliente feito pelo próprio
// administrador — regra de negócio não documentada nas US originais, mas
// necessária para atender clientes que preferem ser cadastrados
// presencialmente na barbearia em vez de pelo app. A senha permite que esse
// mesmo cadastro seja usado depois para login no app (Cadastro/Login de
// Cliente pelo app é a via alternativa, ainda não implementada).
model Cliente {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  telefone     String
  senha        String // hash bcrypt, nunca texto puro
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  agendamentos Agendamento[]

  @@map("clientes")
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CONCLUIDO
  CANCELADO
}

// Entidade referente às User Stories "Consulta/Edição/Exclusão de
// Agendamento" (itens 2.25-2.27). Conecta Cliente, Serviço e Profissional.
//
// Cadastro pelo admin (não documentado nas US originais — mesma lógica do
// cadastro presencial de Cliente): quando o administrador registra um
// agendamento presencialmente, ele já nasce como CONFIRMADO (diferente do
// fluxo do cliente pelo app, que nasceria PENDENTE até a barbearia
// confirmar).
//
// "Exclusão de Agendamento" na documentação descreve, na prática, um
// cancelamento: o critério e os testes falam em status "cancelado" e
// horário liberado, não em remover o registro do banco — por isso o
// service trata a operação de exclusão como uma atualização de status,
// preservando o histórico para os relatórios (Relatório de Agendamentos
// precisa contar confirmados/cancelados/concluídos).
//
// Não existe, nas US, uma ação explícita para marcar um agendamento como
// "concluído" — status também é editável em Edição de Agendamento por
// necessidade prática (sem isso nada chegaria a esse status).
model Agendamento {
  id             Int               @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente           @relation(fields: [clienteId], references: [id])
  servicoId      Int
  servico        Servico           @relation(fields: [servicoId], references: [id])
  profissionalId Int
  profissional   Profissional      @relation(fields: [profissionalId], references: [id])
  dataHora       DateTime
  status         StatusAgendamento
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt

  @@map("agendamentos")
}
