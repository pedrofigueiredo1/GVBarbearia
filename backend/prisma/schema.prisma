// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Entidade referente à User Story "Cadastro de Profissional" (item 2.13 da documentação).
// Campos obrigatórios definidos nos Critérios da US: nome, especialidade e descrição.
model Profissional {
  id            Int      @id @default(autoincrement())
  nome          String
  especialidade String
  descricao     String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@map("profissionais")
}

// Entidade referente à User Story "Cadastro de Serviço" (item 2.9 da documentação).
// Campos obrigatórios definidos nos Critérios da US: nome, descrição, valor e duração.
model Servico {
  id             Int      @id @default(autoincrement())
  nome           String
  descricao      String
  valor          Decimal  @db.Decimal(10, 2)
  duracaoMinutos Int
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@map("servicos")
}

// Entidade referente à User Story "Cadastro de Produto" (item 2.17 da documentação).
// Campos obrigatórios definidos nos Critérios da US: nome, descrição e preço.
model Produto {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String
  preco        Decimal  @db.Decimal(10, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("produtos")
}
