DATABASE_URL="postgresql://gvbarbearia:gvbarbearia@127.0.0.1:5433/gvbarbearia?schema=public"
ADMIN_URL="http://localhost:3001"

# Gere um valor aleatório próprio, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio"

ADMIN_SEED_EMAIL="admin@gvbarbearia.com"
ADMIN_SEED_PASSWORD="admin123"

# Segredo dos tokens JWT do login do cliente (app). Use um valor DIFERENTE do JWT_SECRET.
CLIENTE_JWT_SECRET="troque-por-outro-valor-aleatorio"

# Origens extras liberadas no CORS, separadas por vírgula (só para testar o app no navegador).
CORS_ORIGINS="http://localhost:8081"

# ---- E-mail de recuperação de senha (Brevo, plano gratuito: 300 e-mails por dia) ----
# 1) Crie a conta em https://www.brevo.com  2) Remetentes e IPs > adicione e VERIFIQUE o e-mail remetente
# 3) SMTP e API > Chaves de API > gere uma chave. Sem BREVO_API_KEY os e-mails só aparecem no console do backend.
BREVO_API_KEY=""
MAIL_REMETENTE_EMAIL=""
MAIL_REMETENTE_NOME="GV Barbearia"

# Em produção: NODE_ENV=production (ativa a confiança no proxy e a proteção do seed) e ADMIN_URL com o
# endereço público do painel (o link do e-mail de recuperação aponta para ele).
# NODE_ENV="production"
