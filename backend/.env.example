DATABASE_URL="postgresql://gvbarbearia:gvbarbearia@127.0.0.1:5433/gvbarbearia?schema=public"
ADMIN_URL="http://localhost:3001"

# Gere um valor aleatório próprio, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio"

ADMIN_SEED_EMAIL="admin@gvbarbearia.com"
ADMIN_SEED_PASSWORD="admin123"

# Segredo dos tokens JWT do login do cliente (app). Use um valor DIFERENTE do JWT_SECRET.
CLIENTE_JWT_SECRET="troque-por-outro-valor-aleatorio"

# Origens extras liberadas no CORS, separadas por vírgula (só para testar o app no navegador).
CORS_ORIGINS="http://localhost:8081"
